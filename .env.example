# Antigravity Direct API Environment Variables
# If running on local machine/WSL where `agy` or Antigravity is logged in, these are discovered automatically.
# For cloud deployment (VPS, Docker, AWS, GCP), set your access and refresh tokens here:

ANTIGRAVITY_ACCESS_TOKEN=ya29.your_google_access_token_here
ANTIGRAVITY_REFRESH_TOKEN=1//0your_google_refresh_token_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
